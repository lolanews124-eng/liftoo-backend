DATABASE_URL="postgresql://liftoo:liftoo_secret@localhost:5432/liftoo?schema=public"
JWT_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
OTP_DEV_MODE=true
PLATFORM_FEE_PERCENT=10
REFERRAL_REWARD_AMOUNT=100
PORT=5000
API_PUBLIC_URL="https://api.liftoo.in"
# Google Maps — server-side geocoding & place search (keep secret, never commit real key)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
ADMIN_DEV_MODE=true
ADMIN_DEV_EMAIL=admin@liftoo.in
ADMIN_DEV_PASSWORD=admin123
MATCH_RADIUS_KM=15
BOOKING_SEARCH_TIMEOUT_MIN=15
# Email OTP (Hostinger SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@liftoo.in
SMTP_PASS=your-email-password
SMTP_FROM="Liftoo <contact@liftoo.in>"
# Set false in production so real OTPs are emailed (not 123456)
OTP_DEV_MODE=false
# Firebase Cloud Messaging (download JSON from Firebase Console → Service accounts)
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase/liftoo-6672b-service-account.json
# PAYMENT_GATEWAY_KEY=
