DATABASE_URL="postgresql://liftoo:liftoo_secret@localhost:5432/liftoo?schema=public"
JWT_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
OTP_DEV_MODE=true
PLATFORM_FEE_PERCENT=10
REFERRAL_REWARD_AMOUNT=100
PORT=3000
API_PUBLIC_URL="https://api.liftoo.in"
